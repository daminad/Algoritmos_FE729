Algoritmo contraseñaexacta
	
	definir op Como entero
	Escribir "Ingrese la contraseña"
	Leer op
	
	mientras op <> 1125348489 hacer
		escribir "contraseña incorrecta, intentelo de nuevo"
		repetir 
			Escribir "Ingrese la contraseña"
			Leer op
		Hasta Que op = 1125348489
		si op <> 1125348489 
			escribir "contraseña incorrecta, intentelo de nuevo"
		FinSi
	FinMientras
	
	
FinAlgoritmo